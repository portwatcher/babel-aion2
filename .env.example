# Local development only. Production values come from the infra secret store.
DATABASE_URL=postgresql://babel:babel@localhost:55432/babel
NUXT_DATABASE_URL=postgresql://babel:babel@localhost:55432/babel
NUXT_SITE_URL=http://localhost:3000
# Generate with: openssl rand -base64 48
NUXT_BETTER_AUTH_SECRET=
# Set the real Access team domain and application audience to enable /admin.
NUXT_ACCESS_TEAM_DOMAIN=
NUXT_ACCESS_AUDIENCE=
# Protects dynamic server credentials. Generate with: openssl rand -base64 32
# Keep this key separate from database backups. Never expose it as public config.
NUXT_PROVIDER_ENCRYPTION_KEY=
# Worker uses the same protected credential key as the web server.
PROVIDER_ENCRYPTION_KEY=
# Optional private media control, shared only by web and voice-worker servers.
# Generate a separate random secret; never expose these as public runtime config.
MEDIA_CONTROL_SECRET=
MEDIA_CONTROL_HOST=127.0.0.1
MEDIA_CONTROL_PORT=3100
NUXT_MEDIA_CONTROL_URL=
NUXT_MEDIA_CONTROL_SECRET=
# Optional media network. Empty values use host candidates only (local ICE-lite).
# Real destinations and the Coturn shared secret belong in private runtime config.
MEDIA_STUN_URL=
# JSON array of turn:/turns: URLs. With worker policy 'all', also set STUN explicitly.
MEDIA_TURN_URLS=[]
MEDIA_TURN_SHARED_SECRET=
# Optional separate worker endpoint; otherwise the first TURN URL is used.
MEDIA_WORKER_TURN_URL=
MEDIA_ICE_POLICY=all
MEDIA_BROWSER_ICE_POLICY=all
MEDIA_TURN_TTL_SECONDS=3600
# Optional actual local IPv4 address and inclusive UDP port range, e.g. 43000-43100.
# A port range requires a bind address. NAT mappings/firewall rules are external.
MEDIA_ICE_BIND_ADDRESS=
MEDIA_ICE_PORT_RANGE=
