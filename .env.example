# Local development only. Production values come from the infra secret store.
DATABASE_URL=postgresql://babel:babel@localhost:55432/babel
NUXT_DATABASE_URL=postgresql://babel:babel@localhost:55432/babel
NUXT_SITE_URL=http://localhost:3000
# Generate with: openssl rand -base64 48
NUXT_BETTER_AUTH_SECRET=
# Set the real Access team domain and application audience to enable /admin.
NUXT_ACCESS_TEAM_DOMAIN=
NUXT_ACCESS_AUDIENCE=
# Reserved for the provider implementation. Never expose this as public config.
NUXT_PROVIDER_ENCRYPTION_KEY=
